# Copiá este archivo como .env y completá los valores.

# Dejalo vacío: la página llama a /api y Vite (en la compu) o Cloudflare
# (publicada) lo pasan al backend. Solo cambialo si sabés lo que hacés.
VITE_API_URL=

# ID de cliente OAuth de Google (el mismo GOOGLE_CLIENT_ID del backend)
VITE_GOOGLE_CLIENT_ID=

# En Cloudflare Pages, además, como variable del proyecto (no va en este archivo):
# API_ORIGEN=https://TU-BACKEND.onrender.com
