# Copiá este archivo como ".env" y completá los valores (el .env nunca se sube a GitHub)

# Base de datos (Supabase > Project Settings > Database > Connection string)
DATABASE_URL=

# Clave para firmar las sesiones: un texto largo y al azar
JWT_SECRET=

# Puerto (en Render lo pone solo)
PORT=3001
# "production" en el hosting
NODE_ENV=development

# Dirección del frontend (para CORS, los links de los mails y la vuelta de Mercado Pago).
# Se pueden poner varias separadas por coma.
FRONTEND_URL=http://localhost:5173

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Mails (cuenta de Gmail con "contraseña de aplicación")
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Elegant Music Studio
# A dónde llegan los avisos para el estudio (si se deja vacío, a EMAIL_USER)
EMAIL_AVISOS=

# Inicio de sesión con Google (mismo Client ID que en el frontend)
GOOGLE_CLIENT_ID=

# Mercado Pago (para la demo, credenciales de PRUEBA)
MP_ACCESS_TOKEN=
# Dirección pública del webhook: https://TU-BACKEND/api/pagos/webhook
MP_NOTIFICATION_URL=
MP_WEBHOOK_SECRET=
# "true" solo para probar compras sin Mercado Pago
PERMITIR_COMPRA_SIMULADA=false

# Opcionales (tienen valores por defecto)
POLITICA_DIAS_ARREPENTIMIENTO=10
POLITICA_AVANCE_MAXIMO=20
DIAS_INACTIVIDAD_ALUMNO=90
DIAS_BORRADO_ARCHIVADOS=60
# Sesión: el token de acceso dura minutos; la sesión se cierra sola tras
# N días sin usar la página, y como máximo a los N días de haber entrado.
SESION_MINUTOS_ACCESO=15
SESION_DIAS_INACTIVIDAD=3
SESION_DIAS_MAXIMO=14

# Clave compartida con Cloudflare Pages (misma variable allá). Cualquier texto
# largo y al azar. Sirve para conocer la IP real en los límites de intentos.
PROXY_SECRETO=

# Clases de video (YouTube o Bunny Stream): porcentaje que hay que ver para
# que la clase quede completada. Adelantar el video no cuenta.
VIDEO_PORCENTAJE_MINIMO=50
